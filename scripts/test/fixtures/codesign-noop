#!/usr/bin/env bash
# Minimal codesign stub used by scripts/test/run.sh. Accepts every argv
# combination the production scripts pass and exits 0. The trailing
# `-d -vv` invocation in sign-macos-binary.sh is piped through grep, so
# we emit a fake CodeDirectory describe block on stderr that matches the
# grep filter and produces realistic-looking output.
set -euo pipefail

case "${1:-}" in
  -d*)
    cat >&2 <<'INFO'
Executable=/dev/null
Identifier=tprompt
Authority=Developer ID Application: Test (TEST123456)
TeamIdentifier=TEST123456
Timestamp=Jan 1, 2026 at 12:00:00 PM
flags=0x10000(runtime)
Runtime Version=14.0.0
CDHash=0000000000000000000000000000000000000000
INFO
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
