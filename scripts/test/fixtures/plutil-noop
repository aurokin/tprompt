#!/usr/bin/env bash
# plutil stub. Production calls
#   plutil -extract <key> raw -o - <file>
# to extract a top-level scalar from notarytool's submission JSON.
#
# Real plutil ships only with macOS, so the test harness needs a
# portable substitute that keeps `make test-scripts` (and `make all`)
# working on Linux dev/CI hosts. Delegate the actual JSON parsing to
# python3 so the stub matches plutil's structure-aware semantics
# (nested keys inside string values are not mis-extracted) instead of
# the line-anchored regex behavior the production script just left
# behind.
#
# Argv parsing is explicit so a future reorder of plutil flags in the
# production script doesn't silently misroute `<file>` into a flag.
set -euo pipefail

key=""
out=""
input=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -extract)
      key="${2:-}"
      shift 2
      ;;
    raw)
      shift
      ;;
    -o)
      out="${2:-}"
      shift 2
      ;;
    -*)
      # Real plutil rejects unknown flags. Mirror that strictness so a
      # future production refactor can't silently rely on a flag the
      # stub quietly swallows.
      echo "stub: plutil unknown flag '$1'" >&2
      exit 64
      ;;
    *)
      # Real plutil errors on multiple input paths. Same reason.
      if [[ -n "$input" ]]; then
        echo "stub: plutil received multiple input paths: '$input' '$1'" >&2
        exit 64
      fi
      input="$1"
      shift
      ;;
  esac
done

if [[ -z "$key" || -z "$input" ]]; then
  echo "stub: plutil missing -extract <key> or input file: key='$key' input='$input'" >&2
  exit 64
fi

if [[ ! -f "$input" ]]; then
  echo "stub: plutil input file does not exist: $input" >&2
  exit 1
fi

/usr/bin/env python3 - "$key" "$input" "$out" <<'PY'
import json, sys
key, path, dest = sys.argv[1], sys.argv[2], sys.argv[3]
# Pin UTF-8 explicitly so the stub doesn't depend on $LC_ALL / $LANG.
# Real plutil is UTF-8 native; under LC_ALL=C python3 would otherwise
# default to ASCII and reject any non-ASCII byte in the JSON.
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
    sys.stderr.write(f"stub: plutil could not parse {path}: {exc}\n")
    sys.exit(1)
if not isinstance(data, dict) or key not in data:
    sys.stderr.write(f"stub: plutil key '{key}' not found at top level of {path}\n")
    sys.exit(1)
val = data[key]
# `plutil -extract … raw` only emits scalars; non-scalar would be a
# real plutil error. Fail loudly so the stub doesn't silently succeed
# where production would error.
if isinstance(val, (dict, list)):
    sys.stderr.write(f"stub: plutil -extract raw cannot serialize non-scalar at '{key}'\n")
    sys.exit(1)
text = val if isinstance(val, str) else json.dumps(val)
if dest == "" or dest == "-":
    sys.stdout.write(text + "\n")
else:
    with open(dest, "w", encoding="utf-8") as f:
        f.write(text + "\n")
PY
