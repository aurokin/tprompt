#!/usr/bin/env bash
# notarytool stub that emits a fixture-shaped Accepted submission for
# `submit` and writes a no-op log file for `log`. Used to drive
# notarize-macos-binary.sh's status-parsing happy path.
#
# Argv parsing is explicit (rather than relying on positional indices)
# so a future reorder of submit_args / log_args in the production
# script doesn't silently misroute the output path or skip a required
# flag.
set -euo pipefail

case "${1:-}" in
  notarytool)
    case "${2:-}" in
      submit)
        # Assert the production script passed every flag we expect.
        # A regression that drops one would fail the stub loudly
        # rather than silently produce a fake Accepted result.
        argv="$*"
        for required in --keychain-profile --team-id --wait --output-format; do
          if [[ "$argv" != *"$required"* ]]; then
            echo "stub: notarytool submit missing required flag $required: $argv" >&2
            exit 64
          fi
        done
        # Apple grammar: `submit <archive> {auth options} [other options]`.
        # Auth flags (--keychain-profile, --team-id, --keychain) must
        # all appear before the first non-auth option (--wait,
        # --output-format). Walk argv after `submit <archive>` to
        # enforce the contract.
        shift 2 # drop "notarytool submit"
        if [[ $# -lt 1 ]]; then
          echo "stub: notarytool submit missing archive positional" >&2
          exit 64
        fi
        shift # drop archive
        saw_other=0
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --keychain-profile|--team-id|--keychain)
              if [[ "$saw_other" -eq 1 ]]; then
                echo "stub: $1 (auth) appeared after a non-auth flag; notarytool requires auth flags first" >&2
                exit 64
              fi
              shift 2
              ;;
            --wait)
              saw_other=1
              shift
              ;;
            --output-format)
              saw_other=1
              shift 2
              ;;
            *)
              shift
              ;;
          esac
        done
        cat <<'JSON'
{
  "id": "abc-123-def",
  "status": "Accepted",
  "message": "Successfully received submission info"
}
JSON
        exit 0
        ;;
      log)
        # Locate the output path: the only positional after `log <id>`
        # that doesn't follow a `--<flag>`. Skip option-bearing flags
        # explicitly.
        if [[ $# -lt 3 ]]; then
          echo "stub: notarytool log requires <id> after subcommand: $*" >&2
          exit 64
        fi
        out=""
        shift 3 # drop "notarytool log <id>"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --keychain-profile|--team-id|--keychain)
              shift 2
              ;;
            --*)
              shift
              ;;
            *)
              out="$1"
              shift
              ;;
          esac
        done
        if [[ -z "$out" ]]; then
          echo "stub: notarytool log missing output path" >&2
          exit 64
        fi
        : > "$out"
        exit 0
        ;;
    esac
    ;;
esac

exit 1
