# TPROMPT_NO_AUTO_START is obsolete for the current TUI handoff path.
# The variable is ignored: TUI should render and exit normally without
# contacting or spawning the daemon.

[!exec:tmux] skip
env TMUX_TMPDIR=$SHORT_TMPDIR
env TPROMPT_NO_AUTO_START=1
env TPROMPT_TEST_RENDERER=cancel

exec tmux new-session -d -s tuinoenv 'sleep 60'

mkdir prompts state

tprompt tui --target-pane %0 --config config.toml
! stderr .

# Daemon was not spawned: no socket, no run lock.
! exec test -e state/daemon.sock
! exec test -e state/daemon.sock.lock

exec tmux kill-server

-- config.toml --
prompts_dir = "prompts"
socket_path = "state/daemon.sock"
log_path = "state/daemon.log"
daemon_auto_start = true
