# `tprompt tui` with --no-daemon-auto-start and the daemon socket missing
# exits ExitDaemon (5) during the pre-flight chain, before any Renderer
# runs. Stderr surfaces the SocketUnavailableError message so users know
# the daemon isn't running. Auto-start is on by default after AUR-266,
# so this script explicitly opts out to keep exercising the
# daemon-unreachable failure path.

mkdir prompts
! tprompt tui --target-pane %0 --no-daemon-auto-start --config config.toml
stderr 'daemon socket .* unavailable'
! stdout .

-- config.toml --
prompts_dir = "prompts"
socket_path = "missing/daemon.sock"
log_path = "missing/daemon.log"
