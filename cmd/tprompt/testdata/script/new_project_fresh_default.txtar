# Fresh install: no config file, no prompts_dir set, and no default global
# prompts directory yet. `tprompt new --project` still writes the project
# prompt; the default global source remains auto-creatable rather than a hard
# prerequisite for project scaffolding.

env HOME=$WORK/home

mkdir repo/.git
cd repo

tprompt new project-review --project
stdout 'repo/tprompt/project-review\.md$'
! stderr .

exists $WORK/repo/tprompt/project-review.md

tprompt list
stdout '^project-review  project  key 1 \(auto\)\n$'
! stderr .
