# On macOS, `tprompt daemon start` runs the AUR-327 trust preflight
# before spawning. With the testscript-wide TPROMPT_UNSAFE_TRUST_PREFLIGHT_BYPASS
# cleared, the test binary (ad-hoc-signed by `go test`) trips the
# gate and the launcher refuses to spawn. Non-darwin platforms have
# no analogue; gate this script darwin-only.

[!darwin] skip

# Disable the suite-wide bypass set in testscript_test.go so the gate
# actually fires for this script.
env TPROMPT_UNSAFE_TRUST_PREFLIGHT_BYPASS=

mkdir prompts state

! tprompt daemon start --config config.toml
stderr 'failed macOS trust check'
stderr 'ad-hoc'

# Daemon was not spawned: no socket, no run lock.
! exec test -e state/daemon.sock
! exec test -e state/daemon.sock.lock

-- config.toml --
prompts_dir = "prompts"
socket_path = "state/daemon.sock"
log_path = "state/daemon.log"
