# `tprompt daemon start` against an already-running daemon prints
# "already running" and does not spawn a duplicate. Exercises the
# AUR-265 launcher's pre-lock probe short-circuit.

mkdir prompts state

# First start spawns the daemon.
tprompt daemon start --config config.toml
stdout 'tprompt daemon started on .*state/daemon.sock'

# Second start sees the socket as ProbeOK and short-circuits.
tprompt daemon start --config config.toml
stdout 'tprompt daemon already running on .*state/daemon.sock'

# Third start, just to be sure.
tprompt daemon start --config config.toml
stdout 'tprompt daemon already running on .*state/daemon.sock'

tprompt daemon stop --config config.toml
stdout 'tprompt daemon stopped'

# Daemon log retains exactly ONE outcome=started entry — the
# subsequent start calls did not re-spawn.
exec sh -c 'grep -c outcome=started state/daemon.log'
stdout '^1$'

-- config.toml --
prompts_dir = "prompts"
socket_path = "state/daemon.sock"
log_path = "state/daemon.log"
