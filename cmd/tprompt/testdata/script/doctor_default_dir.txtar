# doctor on a fresh install reports the resolved default prompts directory
# and tags it [default] so users can see where their prompts live.

env HOME=$WORK/home

tprompt doctor
stdout 'ok   prompts directory exists \(scope global, .*home/\.config/tprompt/prompts\) \[default\]'
stdout 'warn 0 prompts discovered \(run ''tprompt new <id>'' to create one\)'

exists $WORK/home/.config/tprompt/prompts
