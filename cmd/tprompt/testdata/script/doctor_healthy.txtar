# doctor with valid config and prompts reports all ok (except tmux).

mkdir prompts
tprompt doctor --config config.toml
stdout 'ok   config loaded'
stdout 'ok   prompts directory exists \(scope global, .*prompts\) \[explicit\]'
stdout 'ok   2 prompts discovered'
stdout 'warn not inside tmux'
stdout 'clipboard reader'
# Outside tmux the popup-binding check is skipped (list-keys needs a server),
# so it must not emit any binding line.
! stdout 'key binding runs tprompt'
! stderr .

-- config.toml --
prompts_dir = "prompts"

-- prompts/alpha.md --
Alpha body.

-- prompts/beta.md --
Beta body.
