# `tprompt tui` does not preflight any daemon socket. Deprecated daemon
# auto-start flags are accepted for compatibility and have no effect.

[!exec:tmux] skip

env TMUX_TMPDIR=$SHORT_TMPDIR
env TPROMPT_TEST_RENDERER=cancel

exec tmux new-session -d -s tuiflag 'sleep 60'
exec tmux display-message -p '#{socket_path}'
stdout $SHORT_TMPDIR

mkdir prompts
tprompt tui --target-pane %0 --no-daemon-auto-start --config config.toml
! stderr .
! stdout .

exec tmux kill-server

-- config.toml --
prompts_dir = "prompts"
log_path = "missing/daemon.log"
