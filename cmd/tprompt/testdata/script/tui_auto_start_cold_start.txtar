# Cold-start TUI no longer auto-spawns the daemon. The cancel renderer exits
# cleanly without touching daemon lifecycle state.

[!exec:tmux] skip
env TMUX_TMPDIR=$SHORT_TMPDIR
env TPROMPT_TEST_RENDERER=cancel

exec tmux new-session -d -s tuiauto 'sleep 60'
exec tmux display-message -p '#{socket_path}'
stdout $SHORT_TMPDIR

mkdir prompts state

tprompt tui --target-pane %0 --config config.toml
! stderr .

# Daemon should not have been spawned.
! exec test -e state/daemon.sock
! exec test -e state/daemon.sock.lock

exec tmux kill-server

-- config.toml --
prompts_dir = "prompts"
socket_path = "state/daemon.sock"
log_path = "state/daemon.log"
